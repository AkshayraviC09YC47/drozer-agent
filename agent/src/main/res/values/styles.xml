<resources>

    <!-- ══════════════════════════════════════════════════════════════
         DROZER AGENT — MATERIAL 3 DARK THEME
         ══════════════════════════════════════════════════════════════ -->

    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Color scheme -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>

        <!-- Default widget styles -->
        <item name="materialCardViewStyle">@style/AppTheme.Card</item>
        <item name="toolbarStyle">@style/AppTheme.Toolbar</item>
        <item name="switchStyle">@style/AppTheme.Switch</item>
    </style>

    <!-- ── Toolbar ── -->
    <style name="AppTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorBackground</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="navigationIconTint">@color/colorPrimary</item>
    </style>

    <!-- ── Card ── -->
    <style name="AppTheme.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="AppTheme.Card.Elevated">
        <item name="cardBackgroundColor">@color/colorSurfaceElevated</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ── SwitchMaterial ── -->
    <style name="AppTheme.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switchTrackOff</item>
        <item name="thumbTint">@color/colorPrimary</item>
    </style>

    <!-- ── Danger Button ── -->
    <style name="AppTheme.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/dangerRed</item>
        <item name="android:textColor">@color/colorOnError</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- ── Section Headers ── -->
    <style name="AppTheme.SectionHeader">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <!-- ── Status Label ── -->
    <style name="AppTheme.StatusLabel">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ── Log message text ── -->
    <style name="AppTheme.LogMessage">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ── Log level badge ── -->
    <style name="AppTheme.LogBadge">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>