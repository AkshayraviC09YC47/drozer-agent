<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list_view_row_endpoint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurfaceVariant"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="1dp"
    app:contentPadding="14dp"
    app:rippleColor="@color/ripple"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- ── Endpoint info (left) ── -->
        <LinearLayout
            android:id="@+id/endpoint_description_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/endpoint_toggle"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/endpoint_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/endpoint_name"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <com.reversec.dz.views.ConnectorStatusIndicator
                    android:id="@+id/endpoint_status_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/endpoint_connection_string"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/endpoint_connection_string"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- ── Toggle (right) ── -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/endpoint_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
